generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PROPIETARIO
  COMPRADOR
  ADMIN
}

enum PropertyType {
  CASA
  APARTAMENTO
  LOTE
  LOCAL
}

enum OperationType {
  VENTA
  ARRIENDO
}

enum PropertyStatus {
  PENDIENTE_REVISION
  ACTIVO
  RECHAZADO
  PAUSADO
  VENDIDO
  ARRENDADO
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  nombre        String
  telefono      String?
  whatsapp      String?
  rol           Role      @default(COMPRADOR)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  propiedades         Property[]       @relation("PropietarioProperties")
  solicitudesContacto ContactRequest[] @relation("InteresadoContactRequests")
  busquedasGuardadas  SavedSearch[]
  
  mensajesEnviados    Message[]        @relation("MensajesEnviados")
  mensajesRecibidos   Message[]        @relation("MensajesRecibidos")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  token     String   @unique
  email     String
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

model Property {
  id          String        @id @default(cuid())
  titulo      String
  descripcion String        @db.Text
  tipo        PropertyType
  operacion   OperationType
  precio      Decimal       @db.Decimal(14, 2)
  precioSugerido Decimal?   @db.Decimal(14, 2) @map("precio_sugerido")
  
  areaConstruidaM2 Float? @map("area_construida_m2")
  areaPrivadaM2    Float? @map("area_privada_m2")
  habitaciones     Int?
  banos            Int?
  parqueaderos     Int?
  estrato          Int?
  antiguedadAnios  Int?   @map("antiguedad_anios")
  piso             Int?
  totalPisos       Int?   @map("total_pisos")
  
  ascensor            Boolean @default(false)
  amoblado            Boolean @default(false)
  tieneBalcon         Boolean @default(false) @map("tiene_balcon")
  tieneTerraza        Boolean @default(false) @map("tiene_terraza")
  tienePatio          Boolean @default(false) @map("tiene_patio")
  tieneEstudio        Boolean @default(false) @map("tiene_estudio")
  tieneDeposito       Boolean @default(false) @map("tiene_deposito")
  tieneZonaLavanderia Boolean @default(false) @map("tiene_zona_lavanderia")
  
  administracion Decimal? @db.Decimal(12, 2)
  
  ciudad       String
  departamento String?
  localidad    String?
  barrio       String
  direccion    String
  latitud      Float
  longitud     Float
  telefonoContacto String? @map("telefono_contacto")
  
  caracteristicasSector      Json? @map("caracteristicas_sector")
  caracteristicasAdicionales Json? @map("caracteristicas_adicionales")
  analisisVisual             Json? @map("analisis_visual")
  
  estado           PropertyStatus @default(PENDIENTE_REVISION)
  motivoRechazo    String? @db.Text @map("motivo_rechazo")
  scoreUbicacion   Float? @map("score_ubicacion")

  propietarioId String
  propietario   User   @relation("PropietarioProperties", fields: [propietarioId], references: [id])

  fotos               PropertyPhoto[]
  solicitudesContacto ContactRequest[]
  mensajes            Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tipo])
  @@index([operacion])
  @@index([estado])
  @@index([ciudad])
  @@index([barrio])
  @@index([precio])
  @@index([propietarioId])
  @@index([createdAt])
  @@index([latitud, longitud])
  @@map("properties")
}

model PropertyPhoto {
  id        String  @id @default(cuid())
  url       String
  orden     Int     @default(0)
  esPortada Boolean @default(false) @map("es_portada")

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@map("property_photos")
}

enum ContactRequestStatus {
  NUEVO
  CONTACTADO
  EN_NEGOCIACION
  CERRADO
  DESCARTADO
}

model ContactRequest {
  id       String  @id @default(cuid())
  mensaje  String  @db.Text
  nombre   String  @default("")
  telefono String
  email    String

  leida Boolean @default(false)
  estado ContactRequestStatus @default(NUEVO)
  origen  String @default("formulario_web")
  ipAddress String? @map("ip_address")
  consentimientoDatos Boolean @default(true) @map("consentimiento_datos")

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  interesadoId String?
  interesado   User?   @relation("InteresadoContactRequests", fields: [interesadoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([propertyId])
  @@index([interesadoId])
  @@index([createdAt])
  @@index([estado])
  @@map("contact_requests")
}

model SavedSearch {
  id      String  @id @default(cuid())
  nombre  String?
  filtros Json

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("saved_searches")
}

model Message {
  id            String   @id @default(cuid())
  contenido     String   @db.Text
  
  remitente_id  String
  remitente     User     @relation("MensajesEnviados", fields: [remitente_id], references: [id], onDelete: Cascade)
  
  destinatario_id String
  destinatario  User     @relation("MensajesRecibidos", fields: [destinatario_id], references: [id], onDelete: Cascade)
  
  property_id   String?
  property      Property? @relation(fields: [property_id], references: [id], onDelete: SetNull)
  
  leido         Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([remitente_id])
  @@index([destinatario_id])
  @@index([property_id])
  @@index([createdAt])
  @@map("messages")
}
