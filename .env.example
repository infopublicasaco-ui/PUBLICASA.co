# --- Base de datos (Supabase Postgres) ---
# Connection pooling (usada por la app en runtime)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Conexión directa (usada por Prisma para migraciones)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Auth (NextAuth.js / Auth.js v5) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # generar con: openssl rand -base64 32

# Login con Google (opcional). Si se dejan vacías, el botón de Google no
# aparece y el login por email/password sigue funcionando igual.
# Crear en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Supabase (storage, auth adicional, etc.) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Mapas (navegador de mapa tipo Google Maps) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Agentes de IA (futuro pipeline: fotos, descripciones, pricing) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
