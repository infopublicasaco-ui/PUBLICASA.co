# --- Base de datos (Supabase Postgres) ---
# Connection pooling (usada por la app en runtime)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Conexión directa (usada por Prisma para migraciones)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Auth (NextAuth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# --- Supabase (storage, auth adicional, etc.) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Mapas (navegador de mapa tipo Google Maps) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Agentes de IA (futuro pipeline: fotos, descripciones, pricing) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
